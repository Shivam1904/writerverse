# Copy to backend/.env for local dev (`cp backend/.env.example backend/.env`); the
# values below work as they are with `make up`. Real .env files are git-ignored.
# A hosted server sets the same names in its host's settings (it reads no file).
# On Vercel (production and preview) these MUST be set or the server will not start:
#   DJANGO_SECRET_KEY, DATABASE_URL, CORS_ALLOWED_ORIGINS, FRONTEND_URL, DEFAULT_FROM_EMAIL.
#   Locally they fall back to dev defaults. See backend/config/runtime.py.

# === CORE ===
# Django secret key. This example value works ONLY in local dev (DEBUG on + FRONTEND_URL on
# localhost); anywhere else the server refuses to start with it. Prod: a long random value.
DJANGO_SECRET_KEY=local-dev-only-change-me
# True for local dev only. Off means SSL is required on the database.
DJANGO_DEBUG=True
# Comma-separated host names the API answers to.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Self-hosting (not Vercel): set WRITERVERSE_ENV=production (or preview) so the server knows it
# is deployed: required settings are checked, email verification is on, dev shortcuts are off.
# Also set DJANGO_DEBUG=False and SECURE_PROD=True. Unset = local (or Vercel's own VERCEL_ENV).
# WRITERVERSE_ENV=production
# Prod only: turns on SSL redirect, HSTS and secure cookies. Leave unset locally.
# SECURE_PROD=True

# === DATABASE ===
# Local Docker Postgres from `make up` (docker-compose.yml, 127.0.0.1 only).
DATABASE_URL=postgres://writerverse_user:password@localhost:5432/writerverse
# Optional guard: comma-separated first labels of your PRODUCTION database host(s)
# (e.g. a Neon endpoint id like ep-example-123456). A local run whose DATABASE_URL
# points there stops, unless ALLOW_PRODUCTION_DATABASE=true is set for that one
# command (never in a file). Unset = no guard. See backend/config/runtime.py.
# PRODUCTION_DB_ENDPOINTS=
# Seconds to keep a DB connection open. 0 (default) is right behind a pooler.
# CONN_MAX_AGE=0
# Test database name suffix. Defaults to the checkout folder name in worktrees.
# TEST_DB_SUFFIX=

# === NETWORK ===
# Comma-separated frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5555,http://127.0.0.1:5555
# Comma-separated HTTPS origins for admin/forms CSRF checks. Unset = same as CORS_ALLOWED_ORIGINS.
# CSRF_TRUSTED_ORIGINS=
# Django admin URL path. Local default (DEBUG on): admin. With DEBUG off there is
# NO admin unless this is set; use a long random segment, e.g. ops-7f3k9q2x.
# DJANGO_ADMIN_PATH=

# === EMAIL (password reset, etc.) ===
# Frontend origin used to build emailed links (e.g. the password-reset link).
FRONTEND_URL=http://localhost:5555
# Dev conveniences (e.g. the reset link in the API answer). On only in local dev
# (local runtime + DEBUG + FRONTEND_URL on localhost); false turns them off there too.
# DEV_SHORTCUTS_ENABLED=True
# Per-user limit on requests that run AI.
# AI_RATE_BURST=60/min
# AI_RATE_DAILY=1000/day
# Leave EMAIL_HOST unset locally: emails print to the runserver terminal.
# Set it in prod to switch to real SMTP.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# Sender address for emails, e.g. "WriterVerse <noreply@example.com>". Required
# when deployed (a domain you own); local default: WriterVerse <noreply@localhost>.
# DEFAULT_FROM_EMAIL=

# === AI ENGINE (all optional) ===
# Provider keys. Blank = the app runs and every AI feature answers
# "AI is not configured on this server" (HTTP 503 ai_not_configured).
# One key is enough: each role in ai_engine/config/providers.yml lists both
# providers and uses whichever has a key. Portraits need OPENAI_API_KEY.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: point a provider at a proxy / compatible endpoint.
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=
# True = the startup check warns about AI that can't run for lack of a key.
# False hides that warning (it does not switch AI calls off).
AI_ENABLED=True
# Which AI policy decides who may run AI (backend/usage/policy.py). The default
# allows every AI call; an edition can add usage limits with its own policy.
# WRITERVERSE_AI_POLICY=usage.policy.AIPolicy


# === FILE STORAGE (generated portraits) ===
# Leave all unset locally: files go to backend/media/. Prod (Vercel keeps no
# files): set ALL five to store files in a Cloudflare R2 bucket. Setting only
# some of them stops the server at startup. See backend/config/storage.py.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# Bucket's public base URL (r2.dev address or custom domain), e.g. https://pub-xxxx.r2.dev
# R2_PUBLIC_URL=

# === TELEMETRY (optional; LangChain reads os.environ; synced in config.settings) ===
# True = send a trace of every AI call (prompt + reply) to LangSmith.
LANGSMITH_TRACING=False
# Your LangSmith API key (only read when tracing is on).
LANGSMITH_API_KEY=
# Leave empty for the default: writerverse-prod on Vercel production (or SECURE_PROD), else writerverse-dev.
LANGSMITH_PROJECT=
# LangSmith API address; the default is the hosted service.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# true = drop prompts (inputs) / replies (outputs) from traces, e.g. to keep
# author manuscript text out of LangSmith. Unset = full traces.
LANGSMITH_HIDE_INPUTS=
LANGSMITH_HIDE_OUTPUTS=

# === DEBUG HELPERS ===
# Set to 1 to log persistence audit lines (see backend/common/persistence_audit.py).
# PERSISTENCE_AUDIT=1
# Set to 1 to write every AI call's full prompt + reply to db/logs/ai_calls.jsonl
# (local only; read with `python manage.py ai_calls <turn_id>`).
# AI_CALL_LOG=1
# Set to True to turn on the silk request profiler at /silk/ (DEBUG only; off by
# default because it can deadlock and 500 under parallel requests).
# SILK_ENABLED=True
