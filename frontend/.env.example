# Copy to frontend/.env for local dev (`cp frontend/.env.example frontend/.env`).
# The values below work as they are with `make local`. A hosted build sets the
# same names in its host's settings.

# === API ===
# Base URL the browser calls. Local (make local): the relative /api, so Vite
# proxies to Django. Hosted: the full API URL, e.g. https://api.example.com/api.
VITE_API_URL=/api
# Dev server only (read by vite.config.ts): where Vite proxies /api. Not shipped to the browser.
VITE_DEV_API_PROXY=http://127.0.0.1:8555
