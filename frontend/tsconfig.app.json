{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client", "node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Loose during dev phase — no strict typing, no unused-symbol errors,
       loose `any` everywhere (no contracts before phase 4; see CLAUDE.md).
       The strict guidelines get re-enabled in the phase-4 typing/cleanup pass. */
    "strict": false,
    "erasableSyntaxOnly": true,
    "noUncheckedSideEffectImports": true,

    /* Same aliases as extensions.config.ts. Type-checking always sees the
       empty extension; WRITERVERSE_EXTENSIONS only changes the bundle. */
    "paths": {
      "@wv/*": ["./src/*"],
      "@writerverse/extensions": ["./src/extensions/none.ts"]
    }
  },
  "include": ["src"]
}
