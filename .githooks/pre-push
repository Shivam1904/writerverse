#!/usr/bin/env bash
# Pre-push gate — fast static checks mirroring CI, run before code leaves your machine.
#
# COST SAFETY: this NEVER runs the paid LLM smoke suite. It is checked
# collect-only (import/marker/fixture wiring — zero LLM calls, $0). The real
# paid suite runs ONLY when you explicitly run `make night-eyes-smoke`.
#
# Enable once per clone:  make hooks   (sets core.hooksPath=.githooks)
# Heavy suites (full Django tests, vitest) run in CI, not here, to keep
# push fast — CI is the authoritative pre-merge gate.

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "▶ ruff (backend)"
ruff check backend/

echo "▶ eslint (frontend, zero warnings)"
(cd frontend && npx eslint . --max-warnings 0)

echo "▶ smoke wiring (collect-only — NO LLM calls)"
# --collect-only never executes a test body; API keys force-emptied so even a
# mistaken edit can't bill (conftest skips smoke tests without a key).
OPENAI_API_KEY="" ANTHROPIC_API_KEY="" \
  uv run python -m pytest -m smoke backend/actions/tests/ --collect-only -q

echo "✓ pre-push checks passed (full test suites run in CI)"
